{
  "name": "new-dailylift",
  "private": true,
  "description": "主打精心声音环境的产品 monorepo：app、网站、API 等模块",
  "scripts": {
    "dev": "pnpm --filter dailylift-mobile ios",
    "start": "pnpm --filter dailylift-mobile start",
    "build:ios": "cd apps/mobile && eas build --platform ios --local",
    "build:tf": "cd apps/mobile && eas build --platform ios --local --auto-submit",
    "test": "pnpm -r run test",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
